# Touch Grass 🌿 — Environment Variables Example
# Note: AI settings can also be configured directly via the UI in browser LocalStorage.

# Optional: Default Ollama Base URL for local inference
VITE_OLLAMA_ENDPOINT=http://localhost:11434
VITE_DEFAULT_OLLAMA_MODEL=llama3.2

# Optional: Remote Open-Weight Inference API Endpoint (Do not expose private production keys)
VITE_REMOTE_API_ENDPOINT=https://api.groq.com/openai/v1
VITE_DEFAULT_REMOTE_MODEL=llama-3.1-8b-instant
